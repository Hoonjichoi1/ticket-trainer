# Neon Postgres connection strings.
# DATABASE_URL: pooled connection (note the "-pooler" suffix in the hostname)
# — used by the app at runtime via @prisma/adapter-neon (see lib/db.ts).
# DIRECT_URL: unpooled connection — used by the Prisma CLI for migrations
# (see prisma.config.ts).
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<database>?sslmode=require"

SESSION_SECRET=replace-with-a-long-random-string
DOTENV_CONFIG_QUIET=true
