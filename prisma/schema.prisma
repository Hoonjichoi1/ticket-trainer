generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

enum QueueEntryStatus {
  WAITING
  ADMITTED
  EXPIRED
}

enum Tier {
  SMALL
  MEDIUM
  MEGA
}

enum SessionOutcome {
  SUCCESS
  QUEUE_TIMEOUT
  SEAT_LOST
  PAYMENT_FAILED
  ABANDONED
}

enum SimulationRunStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Concert {
  id     String   @id @default(uuid())
  title  String
  openAt DateTime
  venue  String

  seats          Seat[]
  bookings       Booking[]
  queueEntries   QueueEntry[]
  simulationRuns SimulationRun[]
}

// Each session gets its own independent simulation instance (D-1): its own
// seat map and queue, not a globally shared one. Resolves "재도전" (retry)
// by starting a fresh run. lastTickAt is persisted here (not in memory)
// since the tick engine runs as tick-on-request in serverless route
// handlers with no persistent process between requests.
model SimulationRun {
  id          String              @id @default(uuid())
  concertId   String
  sessionId   String
  tier        Tier
  status      SimulationRunStatus @default(ACTIVE)
  // D-14: this run's own "sale considered open at" reference, snapshotted
  // once by POST /api/session via resolveQueueOpenAt(concert.openAt, now)
  // — never re-derived later. lib/queue.ts's joinQueue reads this instead
  // of the shared Concert.openAt, so a stale seeded openAt doesn't make
  // every session's initial queue position balloon with real-world drift,
  // without mutating the Concert row shared across concurrent sessions.
  queueOpenAt DateTime            @default(now())
  lastTickAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())

  concert      Concert      @relation(fields: [concertId], references: [id])
  seats        Seat[]
  queueEntries QueueEntry[]

  @@index([sessionId])
  @@index([concertId])
}

model Seat {
  id              String     @id @default(uuid())
  concertId       String
  simulationRunId String
  row             String
  number          Int
  status          SeatStatus @default(AVAILABLE)

  concert       Concert       @relation(fields: [concertId], references: [id])
  simulationRun SimulationRun @relation(fields: [simulationRunId], references: [id])
  holds         Hold[]
  booking       Booking?

  @@index([concertId])
  @@index([simulationRunId])
}

// Hold uniqueness: the task spec's literal wording
// (`UNIQUE(seatId) WHERE expiresAt > now()`) cannot be created in
// PostgreSQL — partial index predicates must be IMMUTABLE, and now() is
// STABLE. releasedAt (nullable) replaces the time comparison: a hold is
// "active" iff releasedAt IS NULL. Per ROADMAP D-5, Seat.status is a
// one-way AVAILABLE -> HELD -> SOLD transition: releasedAt marks that a
// hold itself is no longer valid (e.g. lazily expired by the tick engine
// finding expiresAt < now()), but it does NOT flip the seat's status back
// to AVAILABLE — the seat stays claimed by whoever held it, expired or
// not. expiresAt still drives the actual TTL/lazy-expiry logic in
// application code; releasedAt lets booking/payment cheaply check "is my
// hold still valid" and lets SessionResult record hold_expired once.
model Hold {
  id         String    @id @default(uuid())
  seatId     String
  sessionId  String
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  seat Seat @relation(fields: [seatId], references: [id])

  @@unique([seatId], where: raw("\"releasedAt\" IS NULL"), map: "hold_seat_active_unique")
  @@index([expiresAt])
  @@index([seatId, expiresAt])
}

model Booking {
  id          String   @id @default(uuid())
  concertId   String
  seatId      String   @unique
  sessionId   String
  confirmedAt DateTime @default(now())

  concert Concert @relation(fields: [concertId], references: [id])
  seat    Seat    @relation(fields: [seatId], references: [id])

  @@index([concertId])
  @@index([sessionId])
}

model QueueEntry {
  id              String           @id @default(uuid())
  concertId       String
  simulationRunId String
  sessionId       String
  position        Int
  joinedAt        DateTime         @default(now())
  admissionToken  String?
  status          QueueEntryStatus @default(WAITING)

  concert       Concert       @relation(fields: [concertId], references: [id])
  simulationRun SimulationRun @relation(fields: [simulationRunId], references: [id])

  @@index([concertId, sessionId])
  @@index([simulationRunId])
  // D-13 backstop (same role as Hold's hold_seat_active_unique): a run has
  // exactly one sessionId, so this caps it at one non-EXPIRED entry even if
  // joinQueue's FOR UPDATE lock is ever bypassed by a future code change.
  @@unique([simulationRunId], where: raw("status != 'EXPIRED'"), map: "queue_entry_active_unique")
}

model SimulationConfig {
  id                  String @id @default(uuid())
  tier                Tier   @unique
  arrivalRatePerSec   Float
  admissionRatePerSec Float
  // D-23: fixed "open-instant" queue surge — added to arrivalRatePerSec's
  // continuing inflow so joining at t=0 (the exact open moment) still
  // yields a realistically large initial position instead of ~0. See
  // lib/queue.ts's joinQueue for the formula; see ROADMAP D-23 for the
  // real-ticketing research (thousands-to-tens-of-thousands at t=0) behind
  // this addition and each tier's chosen value.
  surgeBaseline       Float  @default(0)
  // D-21: exponential-approach depletion curve steepness (1/sec) —
  // claimCount = floor(poolSize * (1 - e^(-botCurveK * elapsedSinceOpen))).
  // Replaces the old linear botIntensity (seats/sec); renamed rather than
  // reinterpreted in place since the unit/scale is completely different
  // (botCurveK values are small, ~0.001-0.05, not seats/sec).
  // D-23: re-derived against the new (much longer, minutes not seconds)
  // elapsedSinceOpen scale a user actually reaches the seat screen at —
  // see ROADMAP D-23.
  botCurveK           Float
  errorRate           Float
  latencyMs           Int
  seatRows            Int
  seatsPerRow         Int
  zoneCount           Int
}

// One row per session, upserted incrementally starting at Task 008 (queue
// join/admission) and appended to by Task 009/010 as stageTimings/events
// occur. outcome is nullable because it isn't known until the session
// resolves — Task 011 is the only writer that sets it, when it finalizes
// the report (ROADMAP "관측 데이터 원칙": events are recorded where they
// happen, Task 011 only aggregates/reads).
model SessionResult {
  id               String          @id @default(uuid())
  sessionId        String          @unique
  outcome          SessionOutcome?
  stageTimings     Json            @default("{}")
  contentionLosses Int             @default(0)
  events           Json            @default("[]")
  createdAt        DateTime        @default(now())
}
